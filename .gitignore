__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
# 本仓自建的 SDK wheel（sdk/python/dist/semantica_graph_sdk-*.whl）随仓发布
# （离线安装 / 版本归档；口径：每个仓自己构建的 .whl 允许推送），sdist 等其余产物不入库
!sdk/python/dist/
sdk/python/dist/*
!sdk/python/dist/*.whl
.pytest_cache/
.venv/
data/
logs/
*.log
# 离线产物（GB 级镜像包，不入库；SHA256SUMS/说明文本可留）
docker/images/*.tar
docker/images/*.tar.gz
docker/images/*.tgz
# 本地/生产 env 文件（含 Redis 密码、HAProxy stats 凭据）：只保留 docker/.env.example 模板
.env
docker/.env
# 离线构建用预置 wheel（见 docs/本地Docker部署手册.md 2.3）
docker/wheels/
