# Semantica Graph Engine 生产环境变量模板（cp docker/.env.example .env，.env 已被 .gitignore 忽略）
# 所有变量均可省略；缺省值见 docker-compose.yml。修改后需 docker compose up -d --force-recreate 生效。

# --- 引擎 ---
GRAPH_ENGINE_DB_PATH=data/engine.db
GRAPH_ENGINE_SEMANTICA=1
GRAPH_ENGINE_LOG_LEVEL=INFO

# --- Celery worker（compose 栈默认启用；broker/backend 指向【宿主本地 redis】） ---
# 说明：
#   - 本栈【不启动任何 redis 容器】；Celery broker/backend 默认指向宿主本地 redis
#     （redis://:1qaz2wsx3edc@host.docker.internal:6379/0），engine 容器经
#     host.docker.internal（host-gateway）访问；宿主 redis 需监听 0.0.0.0 并开启密码。
#   - docker compose 栈默认 GRAPH_ENGINE_CELERY_ENABLED=1，worker 随引擎在容器内启动；
#   - docker run 单容器默认仍为 0（docker/entrypoint.sh 内缺省），单容器启用需
#     -e GRAPH_ENGINE_CELERY_ENABLED=1 并提供容器内可达的 broker/backend；
#   - 下方两项刻意留空以走 compose 默认；如换另一台 Redis/密码，取消注释并覆写即可。
GRAPH_ENGINE_CELERY_ENABLED=1
# GRAPH_ENGINE_CELERY_BROKER=redis://:1qaz2wsx3edc@host.docker.internal:6379/0
# GRAPH_ENGINE_CELERY_BACKEND=redis://:1qaz2wsx3edc@host.docker.internal:6379/0

# 一键覆写完整 broker/backend URL（保持 enabled=1；可换另一台 Redis 或改密码）：
# CELERY_BROKER_URL=redis://:1qaz2wsx3edc@host.docker.internal:6379/0

# --- RDF/SPARQL 视图护栏（可选；缺省见 engine 内置默认值） ---
# 白名单仅允许 SELECT/ASK/CONSTRUCT/DESCRIBE；查询超时即时中止，结果按行数上限截断。
# GRAPH_ENGINE_SPARQL_TIMEOUT=10
# GRAPH_ENGINE_SPARQL_MAX_ROWS=5000

# --- HAProxy 对外端口（宿主机映射） ---
HAPROXY_HTTP_PORT=18180
HAPROXY_GRPC_PORT=18151
HAPROXY_STATS_PORT=8406

# --- HAProxy stats（生产必改） ---
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=change-me

# --- Neo4j（图引擎的【外部依赖】，可选；引擎当前不读它，见 docs/本地Docker部署手册.md §1/§7.5） ---
# 镜像：scripts/build_neo4j.sh 准备 `ikc-neo4j:<NEO4J_VERSION>`（上游官方镜像，不重编；缺省导出离线包）
# 容器：scripts/docker-run-neo4j.sh start（`--restart unless-stopped`，宿主重启自动拉起）
# 与 compose 栈解耦：Neo4j 不进 docker-compose.yml，用上面这个脚本单独管理。
# NEO4J_VERSION=5.26-community
# NEO4J_CONTAINER=neo4j
# NEO4J_PASSWORD=            # 留空则首次 start 自动生成随机密码并写入本文件（权限 600）；已有数据卷后勿改
# NEO4J_BIND=0.0.0.0         # 只本机用可设 127.0.0.1；同栈容器要经 host.docker.internal 访问时须保持 0.0.0.0
# NEO4J_HTTP_PORT=7474       # 浏览器 http://127.0.0.1:7474
# NEO4J_BOLT_PORT=7687       # bolt://127.0.0.1:7687（同栈容器：bolt://host.docker.internal:7687）
# NEO4J_HEAP=512m            # JVM 堆（NEO4J_server_memory_heap_{initial,max}__size）
# NEO4J_PAGECACHE=512m       # page cache（NEO4J_server_memory_pagecache_size）
# NEO4J_WAIT=90              # start 后等待探活秒数
